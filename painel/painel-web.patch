@@ -0,0 +1,26 @@
+// Cliente da API de Proteção (mesmo domínio do painel, caminho /ec-protecao).
+import { getToken } from '@/utils/auth'
+
+const BASE = '/ec-protecao'
+
+async function call (path, { method = 'GET', body } = {}) {
+  const res = await fetch(BASE + path, {
+    method,
+    headers: {
+      'content-type': 'application/json',
+      'x-ec-token': getToken() || '',
+    },
+    body: body ? JSON.stringify(body) : undefined,
+  })
+  const data = await res.json().catch(() => ({}))
+  if (!res.ok) throw new Error(data.error || ('erro ' + res.status))
+  return data
+}
+
+export const me = () => call('/admin/me')
+export const overview = () => call('/admin/overview')
+export const getRule = (scope, key) => call(`/admin/rules?scope=${encodeURIComponent(scope)}&key=${encodeURIComponent(key || '')}`)
+export const saveRule = (scope, key, data) => call('/admin/rules', { method: 'POST', body: { scope, key, data } })
+export const assignDevice = (deviceId, storeName, sector) => call('/admin/device/assign', { method: 'POST', body: { deviceId, storeName, sector } })
+export const release = (deviceId, minutes) => call('/admin/release', { method: 'POST', body: { deviceId, minutes } })
+export const events = () => call('/admin/events')
