+</template>
+
+<script setup>
+import { ref, reactive, computed, onMounted, h } from 'vue'
+import { ElMessage, ElMessageBox } from 'element-plus'
+import { list as peerList, update as peerUpdate } from '@/api/peer'
+import { list as groupList, create as groupCreate, update as groupUpdate } from '@/api/device_group'
+import { connectByClient } from '@/utils/peer'
+import { timeAgo } from '@/utils/time'
+
+const SEP = ' / '
+const defaultSectors = ['Caixa', 'Balcão', 'Gerência', 'Servidores']
+
+const isOnline = (p) => p.last_online_time && (Date.now() / 1000 - p.last_online_time) < 60
+
+const PcCard = (props, { emit }) => {
+  const p = props.peer
+  const on = isOnline(p)
+  return h('div', {
+    class: ['pc', { online: on }],
+    draggable: 'true',
+    onDragstart: (e) => { e.dataTransfer.effectAllowed = 'move'; emit('dragstart') },
+  }, [
+    h('div', { class: 'pc-top' }, [
+      h('span', { class: 'st', title: on ? 'Online' : 'Offline' }),
+      h('b', { class: 'pc-name', title: p.hostname || '' }, p.alias || p.hostname || p.id),
+    ]),
+    h('div', { class: 'pc-meta' }, [
+      h('span', null, 'ID ' + p.id),
+      h('span', null, on ? 'Online agora' : (p.last_online_time ? timeAgo(p.last_online_time * 1000) : 'Nunca conectou')),
+    ]),
+    h('div', { class: 'pc-actions' }, [
+      h('button', { class: 'pc-btn primary', onClick: () => emit('connect', p) }, 'Conectar'),
+      h('button', { class: 'pc-btn', onClick: () => emit('rename', p) }, 'Apelido'),
+    ]),
+  ])
+}
+PcCard.props = ['peer']
+PcCard.emits = ['dragstart', 'connect', 'rename']
+
+const loading = ref(false)
+const peers = ref([])
+const groups = ref([])
+const search = ref('')
+const dragged = ref(null)
+const overId = ref(null)
+
+const fetchAll = async (fn) => {
+  const out = []
+  for (let page = 1; page <= 20; page++) {
+    const res = await fn({ page, page_size: 500 }).catch(_ => false)
+    const rows = res?.data?.list || []
+    out.push(...rows)
+    if (rows.length < 500) break
+  }
+  return out
+}
+
+const load = async () => {
+  loading.value = true
+  const [p, g] = await Promise.all([fetchAll(peerList), fetchAll(groupList)])
+  peers.value = p
+  groups.value = g
+  loading.value = false
+}
+onMounted(load)
+
+const splitName = (name) => {
+  const i = name.indexOf(SEP)
+  return i === -1 ? [name.trim(), ''] : [name.slice(0, i).trim(), name.slice(i + SEP.length).trim()]
+}
+
+const stores = computed(() => {
+  const map = {}
+  groups.value.forEach(g => {
+    const [store, sector] = splitName(g.name || '')
+    map[store] = map[store] || { name: store, sections: [] }
+    map[store].sections.push({ group: g, label: sector || 'Geral', isGeneral: !sector, peers: [] })
+  })
+  const byGroup = {}
+  Object.values(map).forEach(s => s.sections.forEach(sec => { byGroup[sec.group.id] = sec }))
+  peers.value.forEach(p => { if (byGroup[p.group_id]) byGroup[p.group_id].peers.push(p) })
+  return Object.values(map)
+    .map(s => {
+      s.sections.sort((a, b) => (b.isGeneral - a.isGeneral) || a.label.localeCompare(b.label, 'pt-BR'))
+      const all = s.sections.flatMap(sec => sec.peers)
+      return { ...s, total: all.length, online: all.filter(isOnline).length }
+    })
+    .sort((a, b) => a.name.localeCompare(b.name, 'pt-BR'))
+})
+const groupIds = computed(() => new Set(groups.value.map(g => g.id)))
+const unassigned = computed(() => peers.value.filter(p => !groupIds.value.has(p.group_id)))
+const onlineCount = computed(() => peers.value.filter(isOnline).length)
+
+const q = computed(() => search.value.trim().toLowerCase())
+const match = (p) => !q.value || [p.alias, p.hostname, p.id].some(v => (v || '').toLowerCase().includes(q.value))
+const filter = (list) => list.filter(match)
+const visibleStores = computed(() => !q.value ? stores.value : stores.value.filter(s =>
+  s.name.toLowerCase().includes(q.value) || s.sections.some(sec => sec.peers.some(match))))
+
+const drop = async (group) => {
+  overId.value = null
+  const p = dragged.value
+  dragged.value = null
+  if (!p || p.group_id === group.id) return
+  const old = p.group_id
+  p.group_id = group.id
+  const res = await peerUpdate({ ...p, group_id: group.id }).catch(_ => false)
+  if (res) {
+    ElMessage.success(`${p.alias || p.hostname || p.id} movido para ${group.name}`)
+  } else {
+    p.group_id = old
+  }
+}
+
+const connect = (p) => connectByClient(p.id)
+
+const rename = async (p) => {
+  const r = await ElMessageBox.prompt('Nome que aparece no painel (ex.: Caixa 1)', 'Apelido do computador', {
+    inputValue: p.alias || '', confirmButtonText: 'Salvar', cancelButtonText: 'Cancelar',
+  }).catch(_ => false)
+  if (!r) return
+  const alias = r.value.trim()
+  if (!alias) return
+  const res = await peerUpdate({ ...p, alias }).catch(_ => false)
+  if (res) { p.alias = alias; ElMessage.success('Apelido salvo') }
+}
+
+const dlg = reactive({ visible: false, mode: 'store', title: '', label: '', placeholder: '', value: '', store: '', sectors: [], saving: false, target: null })
+const openStore = () => Object.assign(dlg, {
+  visible: true, mode: 'store', title: 'Nova loja', label: 'Nome da loja', placeholder: 'Ex.: FarmaHall Recreio',
+  value: '', sectors: ['Caixa', 'Balcão'], target: null,
+})
+const openSector = (store) => Object.assign(dlg, {
+  visible: true, mode: 'sector', title: 'Novo setor', label: 'Nome do setor', placeholder: 'Ex.: Caixa, Balcão, Servidores',
+  value: '', store: store.name, target: store,
+})
+const openRename = (store) => Object.assign(dlg, {
+  visible: true, mode: 'rename', title: 'Renomear loja', label: 'Novo nome da loja', placeholder: store.name,
+  value: store.name, target: store,
+})
+const storeCommand = (c, store) => (c === 'sector' ? openSector(store) : openRename(store))
+
+const saveDialog = async () => {
+  const name = dlg.value.replace(/\//g, '-').trim()
+  if (!name) return ElMessage.warning('Digite um nome')
+  dlg.saving = true
+  let ok = true
+  if (dlg.mode === 'store') {
+    if (stores.value.some(s => s.name.toLowerCase() === name.toLowerCase())) {
+      dlg.saving = false
+      return ElMessage.warning('Já existe uma loja com esse nome')
+    }
+    for (const n of [name, ...dlg.sectors.map(s => name + SEP + s)]) {
+      ok = !!(await groupCreate({ name: n }).catch(_ => false)) && ok
+    }
+  } else if (dlg.mode === 'sector') {
+    const full = dlg.store + SEP + name
