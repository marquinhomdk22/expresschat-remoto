+<template>
+  <div class="page">
+    <section v-for="(sec, si) in sections" :key="sec.title" class="sec" :style="{ animationDelay: si * 80 + 'ms' }">
+      <h3>{{ sec.title }}</h3>
+      <p v-if="sec.desc" class="sec-desc">{{ sec.desc }}</p>
+      <div class="cards">
+        <router-link v-for="c in sec.items" :key="c.name" :to="{ name: c.name }" class="card">
+          <span class="ic" :style="{ background: c.bg, color: c.color }">
+            <el-icon><component :is="`el-icon-${c.icon}`"/></el-icon>
+          </span>
+          <span class="txt">
+            <b>{{ c.title }}</b>
+            <small>{{ c.desc }}</small>
+          </span>
+          <el-icon class="go"><el-icon-arrow-right/></el-icon>
+        </router-link>
+      </div>
+    </section>
+  </div>
+</template>
+
+<script setup>
+const T1 = { bg: '#E6F6F3', color: '#17B39B' }
+const T2 = { bg: '#E8F1F9', color: '#3F86C0' }
+const T3 = { bg: '#F1F3F5', color: '#6B7D8C' }
+const sections = [
+  {
+    title: 'Minha conta',
+    items: [
+      { name: 'MyInfo', title: 'Meus dados e senha', desc: 'Trocar a sua senha de acesso', icon: 'UserFilled', ...T1 },
+      { name: 'MyPeer', title: 'Meus computadores', desc: 'PCs em que você entrou com o seu usuário', icon: 'Monitor', ...T1 },
+    ],
+  },
+  {
+    title: 'Lojas',
+    items: [
+      { name: 'StoreBoard', title: 'Lojas e setores', desc: 'Criar lojas e organizar os computadores', icon: 'Shop', ...T2 },
+      { name: 'DeviceGroup', title: 'Lista de grupos de computadores', desc: 'As mesmas lojas, em formato de tabela', icon: 'Grid', ...T2 },
+    ],
+  },
+  {
+    title: 'Avançado',
+    desc: 'Recursos herdados do RustDesk. No dia a dia você não precisa mexer aqui.',
+    items: [
+      { name: 'UserAddressBook', title: 'Agendas', desc: 'Lista de contatos que aparece dentro do programa', icon: 'Notebook', ...T3 },
+      { name: 'UserAddressBookName', title: 'Nomes de agenda', desc: 'Agendas extras compartilhadas entre usuários', icon: 'Collection', ...T3 },
+      { name: 'UserTag', title: 'Etiquetas', desc: 'Marcadores usados nas agendas do programa', icon: 'CollectionTag', ...T3 },
+      { name: 'ShareRecord', title: 'Compartilhamentos', desc: 'Links de acesso temporário gerados', icon: 'Share', ...T3 },
+      { name: 'UserToken', title: 'Sessões ativas', desc: 'Quem está logado agora; dá para desconectar', icon: 'Key', ...T3 },
+      { name: 'Oauth', title: 'Login com Google/GitHub', desc: 'Entrar no painel com contas externas', icon: 'Link', ...T3 },
+      { name: 'ServerCmd', title: 'Comandos do servidor', desc: 'Ferramentas técnicas do servidor', icon: 'Tools', ...T3 },
+    ],
+  },
+]
+</script>
+
+<style scoped lang="scss">
+.page { max-width: 1100px; }
+.sec { margin-bottom: 26px; animation: rise .45s ease both;
+  h3 { margin: 0 0 4px; font-size: 16px; }
+  .sec-desc { margin: 0 0 10px; color: var(--el-text-color-secondary); font-size: 13px; }
+}
+.cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; margin-top: 10px; }
+.card {
+  display: flex; align-items: center; gap: 14px; padding: 14px 16px; border-radius: 12px; text-decoration: none;
+  background: var(--el-bg-color); border: 1px solid var(--el-border-color-lighter); color: var(--el-text-color-primary);
+  transition: transform .15s, box-shadow .2s, border-color .2s;
+  &:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(36, 55, 70, .08); border-color: #17b39b; }
+  .ic { width: 42px; height: 42px; border-radius: 11px; display: grid; place-items: center; font-size: 20px; flex: 0 0 42px; }
+  .txt { display: flex; flex-direction: column; min-width: 0; b { font-size: 14px; } small { color: var(--el-text-color-secondary); font-size: 12px; } }
+  .go { margin-left: auto; color: var(--el-text-color-placeholder); }
