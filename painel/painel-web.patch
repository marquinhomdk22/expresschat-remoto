+}
+.kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 14px; margin-bottom: 16px; }
+.kpi {
+  background: var(--el-bg-color); border: 1px solid var(--el-border-color-lighter); border-radius: 12px;
+  padding: 16px; display: flex; gap: 14px; align-items: center;
+  animation: rise .5s ease both; transition: transform .2s, box-shadow .2s;
+  &:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(36, 55, 70, .08); }
+}
+.kpi-icon { width: 46px; height: 46px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; flex: 0 0 46px; }
+.kpi-num { font-size: 26px; font-weight: 700; line-height: 1.1; small { font-size: 14px; font-weight: 500; } }
+.kpi-label { color: var(--el-text-color-secondary); font-size: 13px; margin-top: 2px; }
+.card {
+  background: var(--el-bg-color); border: 1px solid var(--el-border-color-lighter); border-radius: 12px;
+  padding: 16px 18px; margin-bottom: 16px; animation: rise .5s ease both;
+}
+.card-title { font-weight: 600; margin-bottom: 14px; }
+.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 16px; .card { margin-bottom: 0; } }
+.chart { display: flex; align-items: flex-end; gap: 4px; height: 200px; padding-top: 18px; }
+.col {
+  flex: 1; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; min-width: 0; position: relative;
+  .bar { width: 100%; max-width: 28px; background: linear-gradient(180deg, #62A3D6, #17B39B); border-radius: 5px 5px 0 0; min-height: 2px; transform-origin: bottom; animation: grow .7s cubic-bezier(.2, .8, .2, 1) both; }
+  .val { font-size: 11px; color: var(--el-text-color-secondary); margin-bottom: 2px; }
+  .lbl { font-size: 10px; color: var(--el-text-color-secondary); margin-top: 4px; height: 12px; white-space: nowrap; }
+  &:hover .bar { filter: brightness(1.1); }
+}
+:deep(.rank-row) { display: flex; gap: 12px; align-items: center; padding: 7px 0; }
+:deep(.pos) { width: 24px; height: 24px; border-radius: 50%; background: var(--el-fill-color); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; flex: 0 0 24px; }
+:deep(.rank-main) { flex: 1; min-width: 0; }
+:deep(.rank-top) { display: flex; justify-content: space-between; gap: 8px; font-size: 14px; margin-bottom: 5px; .name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } b { white-space: nowrap; } }
+:deep(.track) { height: 8px; background: var(--el-fill-color-light); border-radius: 4px; overflow: hidden; }
+:deep(.fill) { height: 100%; border-radius: 4px; transform-origin: left; animation: growx .8s cubic-bezier(.2, .8, .2, 1) both; }
+:deep(.empty) { color: var(--el-text-color-secondary); padding: 20px 0; text-align: center; }
+@keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
+@keyframes grow { from { transform: scaleY(0); } to { transform: scaleY(1); } }
+@keyframes growx { from { transform: scaleX(0); } to { transform: scaleX(1); } }
+</style>
