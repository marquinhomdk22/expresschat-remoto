diff --git a/src/views/dashboard/index.vue b/src/views/dashboard/index.vue
new file mode 100644
index 0000000..4f64e0e
--- /dev/null
+++ b/src/views/dashboard/index.vue
@@ -0,0 +1,246 @@
+<template>
+  <div class="dash" v-loading="loading">
+    <div class="dash-head">
+      <div>
+        <h2>Visão geral</h2>
+        <p>Atendimentos remotos dos últimos {{ days }} dias</p>
+      </div>
+      <el-radio-group v-model="days" @change="load">
+        <el-radio-button :label="7">7 dias</el-radio-button>
+        <el-radio-button :label="30">30 dias</el-radio-button>
+        <el-radio-button :label="90">90 dias</el-radio-button>
+      </el-radio-group>
+    </div>
+
+    <div class="kpis">
+      <div class="kpi" v-for="(k, i) in kpis" :key="k.label" :style="{ animationDelay: i * 80 + 'ms' }">
+        <div class="kpi-icon" :style="{ background: k.bg, color: k.color }">
+          <el-icon><component :is="k.icon"/></el-icon>
+        </div>
+        <div>
+          <div class="kpi-num">{{ k.value }}<small v-if="k.unit"> {{ k.unit }}</small></div>
+          <div class="kpi-label">{{ k.label }}</div>
+        </div>
+      </div>
+    </div>
+
+    <div class="card">
+      <div class="card-title">Acessos por dia</div>
+      <div class="chart" v-if="perDay.max">
+        <div class="col" v-for="d in perDay.list" :key="d.key" :title="d.label + ': ' + d.count + ' acesso(s)'">
+          <span class="val" v-if="d.count">{{ d.count }}</span>
+          <div class="bar" :style="{ height: (d.count / perDay.max * 100) + '%' }"></div>
+          <span class="lbl">{{ d.short }}</span>
+        </div>
+      </div>
+      <div class="empty" v-else>Nenhum acesso no período</div>
+    </div>
+
+    <div class="grid">
+      <div class="card">
+        <div class="card-title">Lojas que mais pedem suporte</div>
+        <rank :items="byStore" unit="acesso" color="#17B39B"/>
+      </div>
+      <div class="card">
+        <div class="card-title">Computadores com mais acessos</div>
+        <rank :items="byPeer" unit="acesso" color="#3F86C0"/>
+      </div>
+      <div class="card">
+        <div class="card-title">Atendimentos por técnico</div>
+        <rank :items="byTech" unit="acesso" color="#8B6FD6"/>
+      </div>
+      <div class="card">
+        <div class="card-title">Tempo de atendimento por loja</div>
+        <rank :items="timeByStore" unit="min" color="#E8A33D"/>
+      </div>
+    </div>
+  </div>
+</template>
+
+<script setup>
+import { ref, computed, onMounted, h } from 'vue'
+import { list as auditList } from '@/api/audit'
+import { list as peerList } from '@/api/peer'
+import { list as groupList } from '@/api/device_group'
+
+const Rank = (props) => {
+  if (!props.items.length) return h('div', { class: 'empty' }, 'Sem dados no período')
+  const max = props.items[0].value || 1
+  return h('div', { class: 'rank' }, props.items.map((it, i) => h('div', { class: 'rank-row' }, [
+    h('span', { class: 'pos' }, i + 1),
+    h('div', { class: 'rank-main' }, [
+      h('div', { class: 'rank-top' }, [
+        h('span', { class: 'name', title: it.sub || '' }, it.name),
+        h('b', null, `${it.value} ${props.unit}${it.value === 1 || props.unit === 'min' ? '' : 's'}`),
+      ]),
+      h('div', { class: 'track' }, h('div', {
+        class: 'fill',
+        style: { width: (it.value / max * 100) + '%', background: props.color, animationDelay: i * 60 + 'ms' },
+      })),
+    ]),
+  ])))
+}
+Rank.props = ['items', 'unit', 'color']
+
+const days = ref(30)
+const loading = ref(false)
+const conns = ref([])
+const peers = ref([])
+const groups = ref([])
+
+const parseTime = (t) => {
+  if (!t) return 0
+  if (typeof t === 'number') return t > 1e12 ? t : t * 1000
+  return new Date(String(t).replace(' ', 'T')).getTime() || 0
+}
+
+const fetchAll = async (fn, params = {}, max = 20) => {
+  const out = []
+  for (let page = 1; page <= max; page++) {
+    const res = await fn({ ...params, page, page_size: 500 }).catch(_ => false)
+    const rows = res?.data?.list || []
+    out.push(...rows)
+    if (rows.length < 500) break
+  }
+  return out
+}
+
+const load = async () => {
+  loading.value = true
+  const [c, p, g] = await Promise.all([fetchAll(auditList), fetchAll(peerList), fetchAll(groupList)])
+  conns.value = c
+  peers.value = p
+  groups.value = g
+  loading.value = false
+}
+onMounted(load)
+
+const peerMap = computed(() => Object.fromEntries(peers.value.map(p => [p.id, p])))
+const groupMap = computed(() => Object.fromEntries(groups.value.map(g => [g.id, g.name])))
+const peerName = (id) => {
+  const p = peerMap.value[id]
+  return p ? (p.alias || p.hostname || id) : id
+}
+const storeOf = (id) => groupMap.value[peerMap.value[id]?.group_id] || 'Sem loja definida'
+
+const since = computed(() => {
+  const d = new Date()
+  d.setHours(0, 0, 0, 0)
+  return d.getTime() - (days.value - 1) * 86400000
+})
+const sessions = computed(() => conns.value
+  .filter(c => c.peer_id)
+  .map(c => {
+    const start = parseTime(c.created_at)
+    const end = c.close_time ? c.close_time * 1000 : 0
+    return { ...c, start, minutes: end > start ? (end - start) / 60000 : 0 }
+  })
+  .filter(c => c.start >= since.value))
+
+const top = (map, n = 6) => Object.entries(map)
+  .map(([name, v]) => ({ name, value: Math.round(v.value ?? v), sub: v.sub }))
+  .filter(x => x.value > 0)
+  .sort((a, b) => b.value - a.value)
+  .slice(0, n)
+
+const countBy = (fn) => {
+  const m = {}
+  sessions.value.forEach(s => { const k = fn(s); m[k] = (m[k] || 0) + 1 })
+  return m
+}
+const byStore = computed(() => top(countBy(s => storeOf(s.peer_id))))
+const byPeer = computed(() => {
+  const m = {}
+  sessions.value.forEach(s => {
+    const k = peerName(s.peer_id)
+    m[k] = m[k] || { value: 0, sub: storeOf(s.peer_id) }
+    m[k].value++
+  })
+  return top(m)
+})
+const byTech = computed(() => top(countBy(s => s.from_name || s.from_peer || 'Desconhecido')))
+const timeByStore = computed(() => {
+  const m = {}
+  sessions.value.forEach(s => { const k = storeOf(s.peer_id); m[k] = (m[k] || 0) + s.minutes })
+  return top(m)
+})
+
+const perDay = computed(() => {
+  const list = []
+  for (let i = 0; i < days.value; i++) {
+    const d = new Date(since.value + i * 86400000)
+    list.push({
+      key: d.toDateString(),
+      short: days.value > 31 ? (d.getDate() === 1 || i === 0 ? `${d.getDate()}/${d.getMonth() + 1}` : '') : `${d.getDate()}/${d.getMonth() + 1}`,
+      label: d.toLocaleDateString('pt-BR'),
+      count: 0,
+    })
+  }
+  const idx = Object.fromEntries(list.map((d, i) => [d.key, i]))
+  sessions.value.forEach(s => {
+    const i = idx[new Date(s.start).toDateString()]
+    if (i !== undefined) list[i].count++
+  })
+  return { list, max: Math.max(0, ...list.map(d => d.count)) }
+})
+
+const kpis = computed(() => {
+  const now = Date.now() / 1000
+  const online = peers.value.filter(p => p.last_online_time && now - p.last_online_time < 300).length
+  const minutes = sessions.value.reduce((a, s) => a + s.minutes, 0)
+  return [
+    { label: 'Computadores cadastrados', value: peers.value.length, icon: 'Monitor', bg: '#E8F1F9', color: '#3F86C0' },
+    { label: 'Online agora', value: online, icon: 'Connection', bg: '#E6F6F3', color: '#17B39B' },
+    { label: 'Acessos no período', value: sessions.value.length, icon: 'Pointer', bg: '#F1ECFB', color: '#8B6FD6' },
+    {
+      label: 'Tempo em atendimento',
+      value: minutes >= 120 ? (minutes / 60).toFixed(1).replace('.', ',') : Math.round(minutes),
+      unit: minutes >= 120 ? 'h' : 'min', icon: 'Timer', bg: '#FCF3E3', color: '#E8A33D',
+    },
+    { label: 'Lojas', value: groups.value.length, icon: 'Shop', bg: '#FDECEF', color: '#D9576F' },
+  ]
+})
+</script>
+
