+        <rank :items="byTech" unit="acesso" color="#8B6FD6"/>
+      </div>
+      <div class="card">
+        <div class="card-title">Tempo de atendimento por loja</div>
+        <rank :items="timeByStore" unit="min" color="#E8A33D"/>
+      </div>
+    </div>
