+          <el-switch v-model="rule.forceStandardUser" @change="touch"/>
+        </div>
+
+        <el-alert type="warning" :closable="false" show-icon class="rel-note"
+                  title="Liberação para o técnico"
+                  description="Precisa instalar algo agora? Libere o computador por um tempo e ele trava de volta sozinho. Escolha o PC na lista abaixo e clique em Liberar."/>
+      </div>
+    </div>
+
+    <!-- dispositivos -->
+    <div class="section-title">Computadores com o ExpressChat Proteção
+      <small v-if="!devices.length">— nenhum instalado ainda. O programa será gerado na próxima etapa.</small>
+    </div>
+    <div class="pcs" v-if="devices.length">
+      <div v-for="d in devices" :key="d.id" class="pc" :class="{ off: !d.online }">
+        <div class="h">
+          <span class="st"></span>
+          <b>{{ d.hostname || d.id }}</b>
+          <span v-if="d.release" class="shield amber"><el-icon><el-icon-timer/></el-icon>Liberado {{ minsLeft(d.release) }}min</span>
+          <span v-else class="shield"><el-icon><el-icon-finished/></el-icon>Protegido</span>
+        </div>
+        <div class="m">
+          <span>{{ d.online ? 'online' : 'offline' }}<template v-if="d.storeName"> · {{ d.storeName }}<template v-if="d.sector"> / {{ d.sector }}</template></template></span>
+          <span><b>{{ (d.stats && d.stats.installsBlockedToday) || 0 }}</b> bloqueios hoje</span>
+        </div>
+        <div class="acts">
+          <el-select :model-value="d.storeName ? d.storeName + '||' + (d.sector || '') : ''" size="small" placeholder="Vincular à loja" @change="v => assign(d, v)" class="assign">
+            <el-option v-for="st in stores" :key="st.name" :label="st.name" :value="st.name + '||'"/>
+            <el-option-group v-for="st in stores" :key="st.name + '-g'" :label="st.name">
+              <el-option v-for="sec in st.sectors" :key="sec" :label="st.name + ' / ' + sec" :value="st.name + '||' + sec"/>
+            </el-option-group>
+          </el-select>
+          <el-button size="small" icon="ElIconTimer" @click="doRelease(d, 30)">Liberar 30min</el-button>
+          <el-button v-if="d.release" size="small" type="danger" text @click="doRelease(d, 0)">Travar</el-button>
+        </div>
+      </div>
+    </div>
+
+    <p class="foot-note">As regras ficam guardadas no seu servidor e são aplicadas pelo programa ExpressChat Proteção, que roda em cada computador.</p>
+  </div>
+</template>
+
+<script setup>
+import { ref, reactive, computed, onMounted, h } from 'vue'
+import { ElMessage } from 'element-plus'
+import * as prot from '@/api/protecao'
+import { list as groupList } from '@/api/device_group'
+
+const DEFAULT = { blockInstall: false, installAllow: [], blockSites: false, sitesMode: 'block', sitesList: [], adultBlock: false, forceStandardUser: false }
+
+const loading = ref(false)
+const saving = ref(false)
+const dirty = ref(false)
+const kpis = reactive({ protected: 0, installsToday: 0, sitesToday: 0, releasesActive: 0 })
+const stores = ref([])
+const devices = ref([])
+const sel = reactive({ scope: 'global', key: '', label: 'Todas as lojas' })
+const rule = reactive(Object.assign({}, DEFAULT))
+
+// editor de chips
+const Chips = (props, { emit }) => {
+  const add = (e) => {
+    const v = (e.target.value || '').trim().toLowerCase()
+    if (v && !props.modelValue.includes(v)) { emit('update:modelValue', [...props.modelValue, v]); emit('change') }
+    e.target.value = ''
+  }
+  const del = (i) => { const a = props.modelValue.slice(); a.splice(i, 1); emit('update:modelValue', a); emit('change') }
+  return h('div', { class: 'chips' }, [
+    ...props.modelValue.map((c, i) => h('span', { class: 'chip' }, [c, h('b', { class: 'x', onClick: () => del(i) }, '×')])),
+    h('input', { class: 'chip-in', placeholder: props.placeholder || 'adicionar', onKeyup: (e) => { if (e.key === 'Enter') add(e) }, onBlur: add }),
+  ])
+}
+Chips.props = ['modelValue', 'placeholder']
+Chips.emits = ['update:modelValue', 'change']
+
+const splitName = (n) => { const i = n.indexOf(' / '); return i === -1 ? [n.trim(), ''] : [n.slice(0, i).trim(), n.slice(i + 3).trim()] }
+
+async function loadGroups () {
+  const res = await groupList({ page: 1, page_size: 500 }).catch(() => false)
+  const list = res?.data?.list || []
+  const map = {}
+  list.forEach(g => {
+    const [store, sector] = splitName(g.name || '')
+    map[store] = map[store] || { name: store, sectors: [], total: 0 }
+    if (sector) map[store].sectors.push(sector)
+  })
+  stores.value = Object.values(map).sort((a, b) => a.name.localeCompare(b.name, 'pt-BR'))
+}
+
+async function loadOverview () {
+  const res = await prot.overview().catch(() => null)
+  if (!res) return
+  Object.assign(kpis, res.kpis)
+  devices.value = res.devices
+  // conta PCs por loja para a árvore
+  const byStore = {}
+  res.devices.forEach(d => { if (d.storeName) byStore[d.storeName] = (byStore[d.storeName] || 0) + 1 })
+  stores.value.forEach(s => { s.total = byStore[s.name] || 0 })
+}
+
+async function pick (scope, key, label) {
+  sel.scope = scope; sel.key = key; sel.label = label
+  const res = await prot.getRule(scope, key).catch(() => ({ rule: Object.assign({}, DEFAULT) }))
+  Object.assign(rule, DEFAULT, res.rule)
+  dirty.value = false
+}
+const touch = () => { dirty.value = true }
+
+async function save () {
+  saving.value = true
+  try {
+    await prot.saveRule(sel.scope, sel.key, { ...rule })
+    dirty.value = false
+    ElMessage.success('Regras salvas para ' + sel.label)
+    loadOverview()
+  } catch (e) { ElMessage.error(e.message) } finally { saving.value = false }
+}
+
+const minsLeft = (until) => Math.max(0, Math.round((until - Date.now()) / 60000))
+async function assign (d, v) {
+  const [store, sector] = String(v).split('||')
+  await prot.assignDevice(d.id, store, sector).catch(e => ElMessage.error(e.message))
+  d.storeName = store; d.sector = sector
+  ElMessage.success('Computador vinculado a ' + store + (sector ? ' / ' + sector : ''))
+}
